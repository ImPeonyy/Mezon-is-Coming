// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String                @id
  username        String                @unique
  coin            Int                   @default(0)
  mezon_token     Int                   @default(0)
  invite_link     String                @unique
  avatar          String                @default("https://res.cloudinary.com/do2rk0jz8/image/upload/v1757571181/download_ygjzey.jpg")

  created_at      DateTime              @default(now())
  updated_at      DateTime              @default(now()) @updatedAt
}

model Spin {
  id              String                @id @default(uuid())
  spin_balance    Int                   @default(50)
  spin_limit      Int                   @default(50)
  spin_count      Int                   @default(0)

  created_at      DateTime              @default(now())
  updated_at      DateTime              @default(now()) @updatedAt
}