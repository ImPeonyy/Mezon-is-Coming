// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                    Int                                   @id @default(autoincrement())
  username                              String                                @unique
  mezon_id                              String                                @unique
  coin                                  Int                                   @default(0)
  mezon_token_balance                   Int                                   @default(0)
  total_mezon_token                     Int                                   @default(0)
  invite_code                           String                                @unique
  avatar                                String                                @default("https://res.cloudinary.com/do2rk0jz8/image/upload/v1757571181/download_ygjzey.jpg")

  created_at                            DateTime                              @default(now())
  updated_at                            DateTime                              @default(now()) @updatedAt

  spin                                  Spin?
  village                               Village?
  statistic                             Statistic?
}               

model Spin {                
  id                                    Int                                   @id @default(autoincrement())
  user_id                               Int                                   @unique
  spin_balance                          Int                                   @default(50)
  spin_limit                            Int                                   @default(50)
  total_spined                          Int                                   @default(0)
  spin_win_count                        Int                                   @default(0)
  total_coin_from_spin                  Int                                   @default(0)

  created_at                            DateTime                              @default(now())
  updated_at                            DateTime                              @default(now()) @updatedAt

  user                                  User                                  @relation(fields: [user_id], references: [id])
}

model Village {
  id                                    Int                                   @id @default(autoincrement())
  user_id                               Int                                   @unique                

  level                                 Int                                   @default(1)
  shield                                Int                                   @default(0)

  created_at                            DateTime                              @default(now())
  updated_at                            DateTime                              @default(now()) @updatedAt

  buildings                             Building[]

  user                                  User                                  @relation(fields: [user_id], references: [id])
}

enum BuildingType {
  TOWER
  FARM
  PET_STATUE
  STATUE
  VEHICLE
}

model Building {
  id                                    Int                                   @id @default(autoincrement())
  village_id                            Int                  
  type                                  BuildingType
  level                                 Int                                   @default(1)
  max_level                             Int                                   @default(5)
  is_distroyed                          Boolean                               @default(false)                 

  created_at                            DateTime                              @default(now())
  updated_at                            DateTime                              @default(now()) @updatedAt

  @@unique([village_id, type])

  village                               Village                               @relation(fields: [village_id], references: [id])
}

model Statistic {
  id                                    Int                                   @id @default(autoincrement())
  user_id                               Int                                   @unique
  attack_count                          Int                                   @default(0)
  attacked_count                        Int                                   @default(0)
  attack_success_count                  Int                                   @default(0)
  shield_break_count                    Int                                   @default(0)
  shield_blocked_count                  Int                                   @default(0)

  raid_count                            Int                                   @default(0)
  raided_count                          Int                                   @default(0)
  perfect_raid_count                    Int                                   @default(0)
  total_coin_from_raid                  Int                                   @default(0)
  best_raid                             Int                                   @default(0)

  created_at                            DateTime                              @default(now())
  updated_at                            DateTime                              @default(now()) @updatedAt

  user                                  User                                  @relation(fields: [user_id], references: [id])
}
